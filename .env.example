# Copy to .env in the project root to override docker-compose defaults.
# docker-compose automatically reads a .env file in the same directory as docker-compose.yml.

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:8080

# Optional SMTP for password reset emails. Leave blank to log reset links
# to the backend container's console instead (dev-friendly default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Used by `docker compose exec backend node utils/seedAdmin.js`
ADMIN_EMAIL=admin@fitnesstracker.com
ADMIN_PASSWORD=Admin@123
